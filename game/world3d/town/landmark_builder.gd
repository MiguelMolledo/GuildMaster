class_name LandmarkBuilder
extends RefCounted
## Town landmarks (church, wall, stalls, bridges, mills...) from kit/landmarks, generated by tools/make_landmarks.py.
## The catalogue (kit/landmarks/catalog.json) lists every piece (file, footprint, doors, sockets) and the assemblies
## (a landmark = pieces at plan positions). Plan coordinates as in HouseBuilder: x right, y back, the front at -y.
##   LandmarkBuilder.piece("iglesia_nave_6")            one piece
##   LandmarkBuilder.build("ermita")                    an assembly, its main door at the origin looking to -y
##   LandmarkBuilder.build("puesto_m", {"awning": Color(0.7, 0.2, 0.15), "goods": "fruta"})

const DIR := "res://kit/landmarks/"
## catalogues: the landmarks (tools/make_landmarks.py), the extras (tools/make_extras.py: animals, carts, street
## furniture...), the hand tools (tools/make_utiles.py) and the goods of GuildMaster (tools/make_mercancias.py; the
## furniture, field and building-site pieces). A piece id is unique across both.
const DIRS := ["res://kit/landmarks/", "res://kit/extras/", "res://kit/utiles/", "res://kit/mercancias/", "res://kit/fiestas/"]
const WATER_SHADER := "res://game/world3d/shaders/water_still.gdshader"

const ONE_SHOT := ["echarse", "levantarse"]

static var _cat := {}
static var _scenes := {}
static var _tints := {}  # "material id|colour" -> Material
static var _water: ShaderMaterial


static func catalog() -> Dictionary:
	if _cat.is_empty():
		var cat := {"pieces": {}, "assemblies": {}, "own_materials": {}}
		for dir: String in DIRS:
			var txt := FileAccess.get_file_as_string(dir + "catalog.json")
			if txt == "":
				push_warning("[LandmarkBuilder] no catalogue in %s: run blender -b --python tools/make_landmarks.py / make_extras.py" % dir)
				continue
			var c: Dictionary = JSON.parse_string(txt)
			for id in c.get("pieces", {}):
				c.pieces[id]["dir"] = dir
				cat.pieces[id] = c.pieces[id]
			cat.assemblies.merge(c.get("assemblies", {}))
			cat.own_materials.merge(c.get("own_materials", {}))
		if cat.pieces.is_empty():
			return {}
		_cat = cat
		if OS.is_debug_build():
			print("[LandmarkBuilder] catalogue: %d pieces, %d assemblies" % [_cat.pieces.size(), _cat.assemblies.size()])
	return _cat


static func info(id: String) -> Dictionary:
	var c := catalog()
	if c.is_empty():
		return {}
	return c.pieces.get(id, c.assemblies.get(id, {}))


static func piece(id: String) -> Node3D:
	if not _scenes.has(id):
		var path: String = String(catalog().get("pieces", {}).get(id, {}).get("dir", DIR)) + id + ".gltf"
		_scenes[id] = load(path) if ResourceLoader.exists(path) else null
	var sc: PackedScene = _scenes[id]
	if sc == null:
		push_warning("[LandmarkBuilder] missing piece %s" % id)
		return null
	var n: Node3D = sc.instantiate()
	n.name = id
	_vertex_colors(n)
	return n


## An animated animal of the extras (gallina, cerdo...): the skinned scene with its AnimationPlayer, every animation
## looping, playing `anim` (quieto | comer | andar | tumbado | dormir | girar_izq | girar_der; the birds: echada),
## and two that play once: echarse (from standing to lying) and levantarse.
## The catalogue gives walk_speed (m/s that matches `andar`) and turn_speed (deg/s that matches `girar_*`).
## scripts/animal_agent.gd drives one between points: it turns, walks, eats and lies down.
## coat: one of that animal's coats in the catalogue ("negra", "tordo"...), "azar" for any of them (pass a seed), or
## "" for the animal as named. coats(id) lists them; young(id) names its young (cordero, ternero...).
static func animal(id: String, anim := "quieto", coat := "", seed := 0) -> Node3D:
	id = coat_id(id, coat, seed)
	var n := piece(id)
	if n == null:
		return null
	var ap := n.find_child("AnimationPlayer", true, false) as AnimationPlayer
	if ap:
		for a in ap.get_animation_list():
			# lying down and getting up play once and hold their last frame; the rest loop
			ap.get_animation(a).loop_mode = Animation.LOOP_NONE if a in ONE_SHOT else Animation.LOOP_LINEAR
		ap.playback_default_blend_time = 0.35
		if ap.has_animation(anim):
			ap.play(anim)
	n.set_meta("animal", id)
	return n


static func coats(id: String) -> Array:
	return info(id).get("coats", {}).keys()


static func coat_id(id: String, coat := "", seed := 0) -> String:
	## the piece id of an animal in one of its coats (also for its static poses: coat_id("vaca", "negra") + "_tumbado")
	var cs: Dictionary = info(id).get("coats", {})
	if coat == "" or cs.is_empty():
		return id
	if coat == "azar":
		return String(cs.values()[absi(seed) % cs.size()])
	return String(cs.get(coat, id))


static func young(id: String) -> String:
	return String(info(id).get("young", ""))


static func play(n: Node, anim: String, at := -1.0, speed := 1.0) -> void:
	## switch an animal's animation (blended); `at` >= 0 freezes it at that fraction of the loop (for still shots)
	var ap := n.find_child("AnimationPlayer", true, false) as AnimationPlayer
	if ap == null or not ap.has_animation(anim):
		return
	ap.play(anim, -1.0, speed)
	if at >= 0.0:
		ap.seek(at * ap.get_animation(anim).length, true)
		ap.pause()


## OmniLight3D for every piece under `root` whose catalogue entry has a `light` (street lamps); returns them so the
## caller sets their energy by the hour.
static func lights(root: Node) -> Array:
	var out := []
	var c := catalog()
	if c.is_empty():
		return out
	var stack: Array[Node] = [root]
	while not stack.is_empty():
		var n: Node = stack.pop_back()
		for ch in n.get_children():
			stack.append(ch)
		var li: Dictionary = c.pieces.get(String(n.name), {}).get("light", {})
		if li.is_empty() or not (n is Node3D):
			continue
		var o := OmniLight3D.new()
		o.name = "Luz"
		o.position = HouseBuilder.plan_to_godot(Vector3(li.at[0], li.at[1], li.at[2]))
		o.light_color = Color(li.color[0], li.color[1], li.color[2])
		o.light_energy = li.get("energy", 1.0)
		o.omni_range = li.get("range", 6.0)
		o.shadow_enabled = false
		n.add_child(o)
		out.append(o)
	return out


static func water_material() -> ShaderMaterial:
	if _water == null:
		_water = ShaderMaterial.new()
		_water.shader = load(WATER_SHADER)
		_water.resource_name = "MI_Water"
	return _water


static var _tinted := {}  # "mesh id|surface" -> bool: the surface has vertex colours that are not all white


static func _vertex_colors(n: Node) -> void:
	## Godot's glTF importer gives a surface "vertex colour as albedo" when the surface BEFORE it carries colours: the
	## first surface never gets it (the kit's own vases come out white) and a surface without colours after one with
	## them does (its material then differs from the kit's and opt3d cannot merge it). Set it by what each surface has:
	## on when its vertex colours tint it, off when it has none or they are all white (the same picture, and the same
	## material as the kit props beside it, so opt3d merges them into one surface).
	if n is MeshInstance3D and n.mesh:
		for i in n.mesh.get_surface_count():
			var key := "%d|%d" % [n.mesh.get_instance_id(), i]
			if not _tinted.has(key):
				var tinted := false
				if (n.mesh.surface_get_format(i) & Mesh.ARRAY_FORMAT_COLOR) != 0:
					var cols: PackedColorArray = n.mesh.surface_get_arrays(i)[Mesh.ARRAY_COLOR]
					for c in cols:
						if c.r < 0.98 or c.g < 0.98 or c.b < 0.98:
							tinted = true
							break
				_tinted[key] = tinted
			var m := n.mesh.surface_get_material(i) as BaseMaterial3D
			if m and m.resource_name == "MI_Water":
				# still water (fountain, trough, wash house): one shared animated material
				n.mesh.surface_set_material(i, water_material())
				continue
			if m and m.vertex_color_use_as_albedo != bool(_tinted[key]):
				m.vertex_color_use_as_albedo = bool(_tinted[key])
	for ch in n.get_children():
		_vertex_colors(ch)


## opts: awning (Color: the stall's cloth), goods (String: a goods set of the catalogue), tint ({material name: Color}),
## palette ({roof, plaster, wood, stone}: the houses' texture variants, e.g. {"roof": "roof_pizarra", "stone": "stone_oscura"})
static func build(id: String, opts := {}) -> Node3D:
	var c := catalog()
	var root: Node3D
	if c.get("assemblies", {}).has(id):
		root = Node3D.new()
		root.name = id
		var a: Dictionary = c.assemblies[id]
		for e in a.parts:
			_add(root, e)
		for e in a.get("goods", {}).get(opts.get("goods", ""), []):
			_add(root, e)
	else:
		root = piece(id)
		if root == null:
			return null
	if opts.has("palette"):
		# the houses' colour variants (kit/variants): {roof, plaster, wood, stone} -> texture name, as HouseBuilder defs
		HouseBuilder._palette = opts.palette
		HouseBuilder._apply_palette(root)
		HouseBuilder._palette = {}
	var tints: Dictionary = opts.get("tint", {}).duplicate()
	if opts.has("awning"):
		tints["MI_Awning"] = opts.awning
	if not tints.is_empty():
		_tint(root, tints)
	root.set_meta("landmark", id)
	if OS.is_debug_build():
		print("[LandmarkBuilder] built %s (opts=%s)" % [id, opts])
	return root


static func _add(root: Node3D, e: Array) -> void:
	var n := piece(e[0])
	if n == null:
		return
	n.position = HouseBuilder.plan_to_godot(Vector3(e[1], e[2], e[4] if e.size() > 4 else 0.0))
	n.rotation.y = deg_to_rad(e[3])
	if e.size() > 5:
		n.scale = Vector3.ONE * float(e[5])
	root.add_child(n)


static func _tint(n: Node, tints: Dictionary) -> void:
	## surfaces whose material is named in `tints` get a copy of it with that albedo colour (one copy per colour)
	if n is MeshInstance3D and n.mesh:
		for i in n.mesh.get_surface_count():
			var m := n.mesh.surface_get_material(i) as BaseMaterial3D
			if m == null or not tints.has(m.resource_name):
				continue
			var col: Color = tints[m.resource_name]
			var key := "%d|%s" % [m.get_instance_id(), col.to_html()]
			if not _tints.has(key):
				var v: BaseMaterial3D = m.duplicate()
				v.albedo_color = col
				_tints[key] = v
			n.set_surface_override_material(i, _tints[key])
	for ch in n.get_children():
		_tint(ch, tints)


## Animated parts of a built landmark (mill wheel, sails, portcullis): [{node, axis (Godot space), info}]
static func animated(root: Node) -> Array:
	var out := []
	var c := catalog()
	if c.is_empty():
		return out
	var stack: Array[Node] = [root]
	while not stack.is_empty():
		var n: Node = stack.pop_back()
		for ch in n.get_children():
			stack.append(ch)
		var pinfo: Dictionary = c.pieces.get(String(n.name), {})
		for nm in pinfo.get("nodes", {}):
			var part := n.find_child(nm, true, false) as Node3D
			if part == null:
				continue
			var inf: Dictionary = pinfo.nodes[nm]
			var ax: Array = inf.get("axis", [0, 0, 0])
			out.append({"node": part, "name": nm, "axis": HouseBuilder.plan_to_godot(Vector3(ax[0], ax[1], ax[2])), "info": inf})
	return out


## Merge a built landmark into one mesh with one surface per material (as opt3d does with the houses); the animated
## parts stay as nodes. Returns the merged MeshInstance3D.
static func bake(root: Node3D) -> MeshInstance3D:
	var keep := {}
	for a in animated(root):
		keep[a.node] = true
	var tools := {}
	var mats := {}
	var inv := root.global_transform.affine_inverse() if root.is_inside_tree() else Transform3D.IDENTITY
	var done := []
	_bake_collect(root, root, keep, tools, mats, done, Transform3D.IDENTITY)
	if tools.is_empty():
		return null
	var am := ArrayMesh.new()
	for key in tools:
		am = (tools[key] as SurfaceTool).commit(am)
		am.surface_set_material(am.get_surface_count() - 1, mats[key])
	for mi: MeshInstance3D in done:
		mi.visible = false
	var out := MeshInstance3D.new()
	out.name = "baked"
	out.mesh = am
	root.add_child(out)
	if OS.is_debug_build():
		print("[LandmarkBuilder] baked %s: %d meshes -> %d surfaces" % [root.name, done.size(), am.get_surface_count()])
	return out


static func _bake_collect(n: Node, root: Node3D, keep: Dictionary, tools: Dictionary, mats: Dictionary, done: Array, xf: Transform3D) -> void:
	if keep.has(n):
		return
	var here := xf
	if n is Node3D and n != root:
		here = xf * (n as Node3D).transform
	if n is MeshInstance3D and n.mesh:
		for i in n.mesh.get_surface_count():
			var m: Material = n.get_active_material(i)
			var key: String = _mat_key(m)
			if not tools.has(key):
				var st := SurfaceTool.new()
				st.begin(Mesh.PRIMITIVE_TRIANGLES)
				tools[key] = st
				mats[key] = m
			(tools[key] as SurfaceTool).append_from(n.mesh, i, here)
		done.append(n)
	for ch in n.get_children():
		_bake_collect(ch, root, keep, tools, mats, done, here)


static func _mat_key(m: Material) -> String:
	## the kit .gltf files each bring their own instance of the same material: join them by name and albedo
	if m == null:
		return "null"
	var bm := m as BaseMaterial3D
	if bm == null:
		return str(m.get_instance_id())
	var tex := bm.albedo_texture.resource_path if bm.albedo_texture else ""
	return "%s|%s|%s|%s" % [bm.resource_name.trim_suffix("_Wear"), tex, bm.albedo_color.to_html(), bm.vertex_color_use_as_albedo]


## A rectangular town wall on the 2 m grid, centred on the origin. size: the rectangle of the wall line in tiles
## (even numbers). opts: corners ("esquina" | "torre_redonda" | "torre_cuadrada", or four of them starting at the
## front-right and going counter-clockwise), gate (side "front|right|back|left"), stairs (side).
static func wall_rect(size: Vector2i, opts := {}) -> Node3D:
	var root := Node3D.new()
	root.name = "muralla"
	var hx := size.x
	var hy := size.y  # half sizes in metres = tiles (2 m each, half)
	var corners = opts.get("corners", "esquina")
	if corners is String:
		corners = [corners, corners, corners, corners]
	# sides in order: front (+x), right (+y), back (-x), left (-y); each starts at its corner and runs counter-clockwise
	var pts := [Vector2(-hx, -hy), Vector2(hx, -hy), Vector2(hx, hy), Vector2(-hx, hy)]
	var names := ["front", "right", "back", "left"]
	for i in 4:
		var a: Vector2 = pts[i]
		var b: Vector2 = pts[(i + 1) % 4]
		var d := (b - a).normalized()
		var rot := 90.0 * i
		# the corner at the end of this side (front-right is index 0)
		var ck: String = corners[i]
		var cid := "muralla_esquina" if ck == "esquina" else "muralla_%s_esquina" % ck
		_add(root, [cid, b.x, b.y, rot, 0])
		var c0: String = corners[(i + 3) % 4]
		var start := 1.0 if c0 == "esquina" else 2.0
		var end := (b - a).length() - (1.0 if ck == "esquina" else 2.0)
		var spans := [[start, end]]
		if opts.get("gate", "") == names[i]:
			var mid := (b - a).length() / 2.0
			var g := a + d * mid
			_add(root, ["muralla_puerta", g.x, g.y, rot, 0])
			spans = [[start, mid - 3.0], [mid + 3.0, end]]
		for sp in spans:
			var s: float = sp[0]
			while sp[1] - s > 0.5:
				var two: bool = sp[1] - s >= 3.5
				var ln := 4.0 if two else 2.0
				var p := a + d * (s + ln / 2.0)
				_add(root, ["muralla_tramo" if two else "muralla_tramo_1", p.x, p.y, rot, 0])
				s += ln
		if opts.get("stairs", "") == names[i]:
			var p2 := a + d * (start + 3.0)
			_add(root, ["muralla_escalera", p2.x, p2.y, rot, 0])
	if OS.is_debug_build():
		print("[LandmarkBuilder] wall_rect %s: %d pieces (opts=%s)" % [size, root.get_child_count(), opts])
	return root
