  "hints": [
    {
      "id": "inside",
      "when": {
        "state": "interior",
        "is": "$workshop"
      },
      "target": {
        "world": "station",
        "id": "$first_station"
      },
      "text": "tutorial.hint.inside",
      "until": {
        "ui": "order_given",
        "match": {
          "type": "work_at"
        }
      }
    },
    {
      "id": "master_touch",
      "when": {
        "sim": "master_window",
        "match": {
          "open": true
        }
      },
      "target": {
        "world": "station",
        "id": "$event.zone"
      },
      "text": "tutorial.hint.master_touch",
      "until": {
        "sim": "master_window",
        "match": {
          "open": false
        }
      }
    },
