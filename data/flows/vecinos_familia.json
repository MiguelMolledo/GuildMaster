{
  "id": "vecinos_familia",
  "title": "Vecinos y familia",
  "about": "La ficha de un vecino: hablar, halagar, insultar y amenazar; acusar al rival en su ficha; el árbol de la familia: designar heredero, la escuela de un hijo, el oficio de un adulto; la rutina y las directivas de un familiar; el poder de un cargo; cerrar la dinastía desde el menú.",
  "start": {"scenario": "plaza_dusk"},
  "covers": ["npc_talk", "npc_flatter", "npc_insult", "npc_threaten", "accuse", "designate_heir", "school_choice", "assign_building", "set_schedule", "set_directives", "use_office_power", "close_dynasty"],
  "steps": [
    {"id": "vecino", "say": "Clic en el vecino más cercano: su ficha", "world": {"person": "=q.npc_near()"}, "expect": ["q.visible('NpcPanel')"]},
    {"id": "hablar", "click": {"within": "NpcPanel", "node": "Talk"}, "expect": ["q.order('npc_talk') or q.order('move_to')"]},
    {"id": "halagar", "click": {"within": "NpcPanel", "node": "Flatter", "enabled": true}, "soft": true, "until": "q.order('npc_flatter') or q.visible('ConfirmModal')", "timeout": 4},
    {"id": "halagar_si", "when": "q.visible('ConfirmModal')", "click": {"within": "ConfirmModal", "node": "ConfirmButton"}},
    {"id": "insultar", "click": {"within": "NpcPanel", "node": "Insult", "enabled": true}, "soft": true, "until": "q.order('npc_insult') or q.visible('ConfirmModal')", "timeout": 4},
    {"id": "insultar_si", "when": "q.visible('ConfirmModal')", "click": {"within": "ConfirmModal", "node": "ConfirmButton"}},
    {"id": "amenazar", "click": {"within": "NpcPanel", "node": "Threaten", "enabled": true}, "soft": true, "until": "q.order('npc_threaten') or q.visible('ConfirmModal')", "timeout": 4},
    {"id": "amenazar_si", "when": "q.visible('ConfirmModal')", "click": {"within": "ConfirmModal", "node": "ConfirmButton"}},
    {"id": "esc_vecino", "key": "Escape"},
    {"id": "acusar_escena", "say": "Acusar al rival (escenario rival_accused)", "restart": {"scenario": "rival_accused"}},
    {"id": "pausa_rival", "say": "Espacio: pausa (el rival anda; se le pulsa quieto)", "key": "Space", "expect": ["q.paused()"]},
    {"id": "rival", "say": "Clic en el herrero rival: su ficha con «Acusar…»", "world": {"person": "=q.rival()"}, "expect": ["q.visible('NpcPanel')"]},
    {"id": "acusar", "click": {"within": "NpcPanel", "node": "Accuse"}, "until": "q.order('accuse') or q.visible('ConfirmModal')", "timeout": 4},
    {"id": "acusar_si", "when": "q.visible('ConfirmModal')", "click": {"within": "ConfirmModal", "node": "ConfirmButton"}, "expect": ["q.order('accuse')"]},
    {"id": "seguir_rival", "key": "Space", "expect": ["not q.paused()"]},
    {"id": "familia_escena", "say": "La familia con hijos (escenario founder_old)", "restart": {"scenario": "founder_old"}},
    {"id": "arbol", "key": "@family_tree", "expect": ["q.visible('FamilyTreePanel')"]},
    {"id": "elegir_hija", "say": "Clic en Clara (12) en el árbol", "click": {"within": "FamilyTreePanel", "type": "FamilyTreeNode", "has": "Clara"}},
    {"id": "escuela", "say": "La escuela de Clara", "when": "q.shown({'node': 'SchoolButton', 'enabled': true})", "click": {"node": "SchoolButton"}, "until": "q.visible('ConfirmModal')", "timeout": 4, "soft": true},
    {"id": "escuela_si", "when": "q.visible('ConfirmModal')", "click": {"within": "ConfirmModal", "node": "ConfirmButton"}, "expect": ["q.order('school_choice')"]},
    {"id": "heredero", "say": "Designar heredera a Clara (pide confirmar; si no se puede, apagado con su motivo)", "when": "q.shown({'node': 'HeirButton', 'enabled': true})", "click": {"node": "HeirButton"}, "until": "q.visible('ConfirmModal')", "timeout": 4, "soft": true},
    {"id": "heredero_si", "when": "q.visible('ConfirmModal')", "click": {"within": "ConfirmModal", "node": "ConfirmButton"}, "expect": ["q.order('designate_heir')"]},
    {"id": "elegir_hijo", "say": "Clic en Pere (16)", "click": {"within": "FamilyTreePanel", "type": "FamilyTreeNode", "has": "Pere"}},
    {"id": "oficio", "say": "El oficio de un adulto: el desplegable «Trabaja en»", "when": "q.shown({'node': 'AssignOption'})", "click": {"node": "AssignOption"}, "soft": true},
    {"id": "oficio_elegir", "when": "q.drv.node('AssignOption') != null and q.drv.node('AssignOption').get_popup().visible", "popup": {"node": "AssignOption"}, "item": 0, "soft": true, "expect": ["q.order('assign_building')"]},
    {"id": "esc_arbol", "key": "Escape", "expect": ["not q.visible('FamilyTreePanel')"]},
    {"id": "rutina_escena", "say": "La rutina y las directivas (escenario family_routines)", "restart": {"scenario": "family_routines"}},
    {"id": "ficha", "key": "@inventory", "expect": ["q.visible('CharacterPanel')"]},
    {"id": "pestana_rutina", "click": {"node": "RoutineTab"}},
    {"id": "rutina_cambiar", "say": "Encender o apagar la rutina", "click": {"within": "RoutineEditor", "node": "ToggleButton"}, "soft": true, "expect": ["q.order('set_schedule')"]},
    {"id": "ia", "say": "El botón de la IA del familiar", "click": {"node": "KinAiButton"}, "soft": true, "expect": ["q.visible('KinAiPanel')"]},
    {"id": "directiva", "say": "Cambiar una directiva", "click": {"within": "KinAiPanel", "type": "CheckBox", "enabled": true}, "soft": true, "expect": ["q.order('set_directives')"]},
    {"id": "esc_ia", "key": "Escape"},
    {"id": "cargo_escena", "say": "Un poder de cargo (escenario office_inspector)", "restart": {"scenario": "office_inspector"}},
    {"id": "cargos", "key": "@offices", "expect": ["q.visible('OfficesPanel')"]},
    {"id": "poderes", "click": {"node": "Tab_powers"}},
    {"id": "poder", "say": "Usar el primer poder que se pueda", "click": {"within": "Powers", "prefix": "Use_", "enabled": true}, "until": "q.order('use_office_power') or q.visible('ConfirmModal')", "timeout": 4, "soft": true},
    {"id": "poder_si", "when": "q.visible('ConfirmModal')", "click": {"within": "ConfirmModal", "node": "ConfirmButton"}, "expect": ["q.order('use_office_power')"]},
    {"id": "esc_cargos", "key": "Escape"},
    {"id": "pausa", "say": "Esc: el menú de pausa", "key": "Escape", "expect": ["q.visible('PauseMenu')"]},
    {"id": "cerrar_dinastia", "say": "«Cerrar la dinastía»: si está apagado, dice por qué", "when": "q.disabled({'node': 'CloseDynastyButton'})", "expect": ["q.text('CloseReason') != ''"]},
    {"id": "cerrar_si", "when": "not q.disabled({'node': 'CloseDynastyButton'})", "click": {"node": "CloseDynastyButton"}, "until": "q.visible('Confirm')", "timeout": 4},
    {"id": "cerrar_confirmar", "when": "q.visible('Confirm')", "click": {"within": "Confirm", "type": "Button", "index": 1}, "until": "q.ending() != ''", "timeout": 6, "expect": ["q.order('close_dynasty') or q.ending() != ''"]}
  ]
}
