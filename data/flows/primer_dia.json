{
  "id": "primer_dia",
  "title": "Primer día",
  "about": "Desde la partida nueva: entrar en la forja, sacar lingotes y una espada (modo normal), venderla en la Armería, aceptar y cumplir un encargo y comprar en el puesto con recado. La Forja viva, en el flujo forja_viva.",
  "quick": true,
  "start": {"new_game": true},
  "covers": ["work_at", "stop_work", "transfer", "enter_building", "exit_building", "sell", "buy", "accept_contract", "deliver_contract", "move_to", "unlock_seen"],
  "steps": [
    {"id": "partida_nueva", "say": "La pantalla de partida nueva", "expect": ["q.visible('NewGameScreen')"]},
    {"id": "sin_tutorial", "say": "Quita «Con tutorial» (el tutorial tiene su propio flujo)", "click": {"node": "TutorialCheck"}, "expect": ["not q.drv.node('TutorialCheck').button_pressed"]},
    {"id": "empezar", "say": "Pulsa Empezar", "click": {"node": "StartButton"}, "until": "not q.visible('NewGameScreen') and q.fam() != ''", "expect": ["q.who() != ''", "q.owns('forge')"]},
    {"id": "ayuda", "say": "F1 abre la ayuda", "key": "F1", "expect": ["q.visible('HelpPanel')"]},
    {"id": "ayuda_esc", "say": "Esc la cierra", "key": "Escape", "expect": ["not q.visible('HelpPanel')"]},
    {"id": "velocidad", "say": "Mayús+3: ×4", "key": "@speed_3", "expect": ["q.speed() == 4"]},
    {"id": "andar", "say": "Clic derecho en una calle: anda hasta allí", "world": {"tile": [21, 16]}, "button": "right", "expect": ["q.order('move_to')"]},
    {"id": "a_la_forja", "say": "Clic derecho en la forja: entra", "world": {"own": "forge"}, "button": "right", "until": "q.interior() == q.own('forge') and q.location() == q.own('forge')", "timeout": 30, "fast": 4, "expect": ["q.order('enter_building')"]},
    {"id": "ir_al_puesto", "say": "Clic izquierdo en el almacén: va hasta él", "station": "storage", "button": "left", "expect": ["q.order('go_to_station')"]},
    {"id": "menu_horno", "say": "Clic derecho en el horno: su menú", "station": "furnace", "button": "right", "expect": ["q.visible('StationMenu')"]},
    {"id": "modo_normal", "say": "Modo normal", "click": {"node": "NormalButton"}},
    {"id": "receta_lingote", "say": "La receta del lingote", "click": {"via": "RecipeList", "fn": "get_node", "args": ["Row_forge_ingot"], "type": "Button"}, "expect": ["q.order('work_at')", "not q.visible('StationMenu')"]},
    {"id": "cuatro_lingotes", "say": "Espera a tener cuatro lingotes (dos para la espada, dos para los martillos)", "until": "q.storage('iron_ingot') >= 4", "timeout": 120, "fast": 6},
    {"id": "menu_yunque", "say": "Clic derecho en el yunque (el horno sigue con su lingote)", "station": "anvil", "button": "right", "expect": ["q.visible('StationMenu')"]},
    {"id": "modo_normal_espada", "say": "Modo normal (la Forja viva tiene su propio flujo)", "click": {"node": "NormalButton"}},
    {"id": "receta_espada", "say": "La espada", "click": {"via": "RecipeList", "fn": "get_node", "args": ["Row_forge_sword"], "type": "Button"}, "expect": ["q.order('work_at')"]},
    {"id": "espada_hecha", "say": "Espera la espada", "until": "q.storage('sword') > 0", "timeout": 60, "fast": 6},
    {"id": "almacen", "say": "El botón Almacén (A)", "click": {"node": "StorageButton"}, "expect": ["q.visible('StoragePanel')"]},
    {"id": "coger_espada", "say": "Clic en la espada del almacén: a la bolsa", "click": {"within": "BuildingGrid", "prefix": "sword_"}, "until": "q.bag('sword') > 0", "timeout": 10, "expect": ["q.order('transfer')"]},
    {"id": "salir_forja", "say": "Salir", "click": {"node": "ExitButton"}, "until": "q.interior() == '' and q.location() == ''", "timeout": 20, "fast": 4, "expect": ["q.order('exit_building')"]},
    {"id": "a_la_armeria", "say": "Clic derecho en la Armería", "world": {"building": "armory"}, "button": "right", "until": "q.interior() == q.building('armory')", "timeout": 30, "fast": 4},
    {"id": "mostrador", "say": "Clic en el mostrador", "station": "*", "button": "left", "until": "q.visible('MarketPanel')", "timeout": 8},
    {"id": "pestana_vender", "say": "Pestaña Vender", "click": {"node": "SellTab"}},
    {"id": "vender_espada", "say": "Vender una espada", "click": {"within": {"within": "SellList", "prefix": "sword_"}, "node": "SellOne"}, "until": "q.bag('sword') == 0", "timeout": 10, "expect": ["q.order('sell')", "q.gold() > q.was('gold')"]},
    {"id": "cerrar_mercado", "say": "Cerrar el panel", "click": {"within": "MarketPanel", "node": "CloseButton"}, "expect": ["not q.visible('MarketPanel')"]},
    {"id": "salir_armeria", "say": "Salir de la Armería", "click": {"node": "ExitButton"}, "until": "q.interior() == '' and q.location() == ''", "timeout": 20, "fast": 4},
    {"id": "carta_espera", "say": "La carta del desbloqueo espera sitio en la pila (la de la fiesta va delante): hasta que entra", "until": "q.shown({'within': 'UnlockCard', 'node': 'Button_ok'})", "timeout": 40, "soft": true, "fast": 4},
    {"id": "carta_nuevo", "say": "Fuera de la Armería, la carta «Nuevo: los encargos y el recado» en la pila: Entendido", "when": "q.shown({'within': 'UnlockCard', 'node': 'Button_ok'})", "click": {"within": "UnlockCard", "node": "Button_ok"}, "expect": ["q.order('unlock_seen')"]},
    {"id": "al_tablon", "say": "Clic derecho en el tablón de encargos", "world": {"service": "board"}, "button": "right", "until": "q.visible('BoardPanel')", "timeout": 30, "fast": 4},
    {"id": "aceptar_martillos", "say": "Aceptar el encargo de martillos", "when": "q.board_id('hammer') != ''", "click": {"within": {"node": "='Note_' + q.board_id('hammer')"}, "node": "Accept"}, "expect": ["q.order('accept_contract')", "q.mine_id('hammer') != ''"]},
    {"id": "cerrar_tablon", "say": "Esc cierra el tablón", "key": "Escape", "expect": ["not q.visible('BoardPanel')"]},
    {"id": "vuelta_forja", "say": "De vuelta a la forja", "world": {"own": "forge"}, "button": "right", "until": "q.interior() == q.own('forge') and q.location() == q.own('forge')", "timeout": 30, "fast": 4},
    {"id": "martillo_menu", "say": "Yunque: martillo", "when": "q.mine_id('hammer') != ''", "station": "anvil", "button": "right", "expect": ["q.visible('StationMenu')"]},
    {"id": "martillo_normal", "when": "q.mine_id('hammer') != ''", "click": {"node": "NormalButton"}},
    {"id": "martillo_receta", "when": "q.mine_id('hammer') != ''", "click": {"via": "RecipeList", "fn": "get_node", "args": ["Row_forge_hammer"], "type": "Button"}, "expect": ["q.order('work_at')"]},
    {"id": "martillo_hecho", "when": "q.mine_id('hammer') != ''", "until": "q.storage('hammer') >= 2", "timeout": 120, "fast": 6, "say": "Espera a los dos martillos (la receta se repite)"},
    {"id": "parar", "say": "Clic derecho en el yunque y Parar", "when": "q.working('anvil')", "station": "anvil", "button": "right"},
    {"id": "parar_boton", "when": "q.visible('StationMenu')", "click": {"node": "StopButton"}, "expect": ["q.order('stop_work')"]},
    {"id": "tecla_almacen", "say": "A abre el almacén", "key": "@panel_storage", "expect": ["q.visible('StoragePanel')"]},
    {"id": "coger_productos", "say": "«Coger productos»", "click": {"node": "TakeButton"}, "until": "q.bag('hammer') >= 2 or q.mine_id('hammer') == ''", "timeout": 10},
    {"id": "salir_2", "click": {"node": "ExitButton"}, "until": "q.interior() == '' and q.location() == ''", "timeout": 20, "fast": 4},
    {"id": "tablon_2", "world": {"service": "board"}, "button": "right", "until": "q.visible('BoardPanel')", "timeout": 30, "fast": 4},
    {"id": "entregar", "say": "Entregar el encargo", "when": "q.mine_id('hammer') != ''", "click": {"within": {"node": "='Row_' + q.mine_id('hammer')"}, "node": "Deliver"}, "expect": ["q.order('deliver_contract')"]},
    {"id": "cerrar_tablon_2", "key": "Escape"},
    {"id": "espera_mercado", "say": "De noche el mercado cierra: espera a que abra (×4)", "when": "not q.market_open('resources')", "until": "q.market_open('resources')", "timeout": 60, "fast": 6},
    {"id": "al_puesto", "say": "Clic derecho en el puesto de recursos", "world": {"service": "resources"}, "button": "right", "until": "q.visible('MarketPanel')", "timeout": 30, "fast": 4},
    {"id": "pestana_comprar", "click": {"node": "BuyTab"}},
    {"id": "mas_madera", "say": "+ en la madera", "click": {"within": {"within": "BuyList", "prefix": "wood_"}, "node": "Plus"}},
    {"id": "recado", "say": "«Enviar a… Forja» (recado)", "click": {"within": {"within": "BuyList", "prefix": "wood_"}, "node": "Send"}},
    {"id": "recado_destino", "say": "El destino del recado", "popup": {"within": {"within": "BuyList", "prefix": "wood_"}, "node": "Send"}, "item": 0, "expect": ["q.order('buy')", "q.deliveries() > 0"], "soft": false},
    {"id": "fin", "say": "Cerrar con Esc", "key": "Escape", "expect": ["not q.visible('MarketPanel')"]}
  ]
}
