{
  "id": "esc",
  "title": "Cada pantalla se cierra con Esc",
  "about": "Abre cada panel y pantalla (por su tecla o su clic) y comprueba que Esc la cierra: los paneles de la ciudad, los del interior, el menú de un puesto, el menú de pausa con guardar y cargar, el mapa, y las pantallas del título.",
  "start": {"scenario": "town_e_start"},
  "covers": [],
  "steps": [
    {"id": "reinicio_0", "restart": {"scenario": "town_e_start"}},
    {"key": "@ledger", "id": "abre_LedgerPanel_0", "say": "Abrir LedgerPanel", "expect": ["q.visible('LedgerPanel')"]},
    {"id": "esc_LedgerPanel_0", "say": "Esc cierra LedgerPanel", "key": "Escape", "expect": ["not q.visible('LedgerPanel')"], "soft": true},
    {"id": "reinicio_1", "restart": {"scenario": "town_e_start"}},
    {"key": "@family_tree", "id": "abre_FamilyTreePanel_1", "say": "Abrir FamilyTreePanel", "expect": ["q.visible('FamilyTreePanel')"]},
    {"id": "esc_FamilyTreePanel_1", "say": "Esc cierra FamilyTreePanel", "key": "Escape", "expect": ["not q.visible('FamilyTreePanel')"], "soft": true},
    {"id": "reinicio_2", "restart": {"scenario": "town_e_start"}},
    {"key": "@inventory", "id": "abre_CharacterPanel_2", "say": "Abrir CharacterPanel", "expect": ["q.visible('CharacterPanel')"]},
    {"id": "esc_CharacterPanel_2", "say": "Esc cierra CharacterPanel", "key": "Escape", "expect": ["not q.visible('CharacterPanel')"], "soft": true},
    {"id": "reinicio_3", "restart": {"scenario": "town_e_start"}},
    {"key": "@offices", "id": "abre_OfficesPanel_3", "say": "Abrir OfficesPanel", "expect": ["q.visible('OfficesPanel')"]},
    {"id": "esc_OfficesPanel_3", "say": "Esc cierra OfficesPanel", "key": "Escape", "expect": ["not q.visible('OfficesPanel')"], "soft": true},
    {"id": "reinicio_4", "restart": {"scenario": "town_e_start"}},
    {"key": "@help", "id": "abre_HelpPanel_4", "say": "Abrir HelpPanel", "expect": ["q.visible('HelpPanel')"]},
    {"id": "esc_HelpPanel_4", "say": "Esc cierra HelpPanel", "key": "Escape", "expect": ["not q.visible('HelpPanel')"], "soft": true},
    {"id": "reinicio_5", "restart": {"scenario": "town_e_start"}},
    {"key": "@region_map", "id": "abre_RegionScreen_5", "say": "Abrir RegionScreen", "expect": ["q.visible('RegionScreen')"]},
    {"id": "esc_RegionScreen_5", "say": "Esc cierra RegionScreen", "key": "Escape", "expect": ["not q.visible('RegionScreen')"], "soft": true},
    {"id": "reinicio_6", "restart": {"scenario": "town_e_start"}},
    {"key": "Escape", "id": "abre_PauseMenu_6", "say": "Abrir PauseMenu", "expect": ["q.visible('PauseMenu')"]},
    {"id": "esc_PauseMenu_6", "say": "Esc cierra PauseMenu", "key": "Escape", "expect": ["not q.visible('PauseMenu')"], "soft": true},
    {"id": "reinicio_7", "restart": {"scenario": "town_e_start"}},
    {"key": "F5", "id": "abre_SaveScreen_7", "say": "Abrir SaveScreen", "expect": ["q.visible('SaveScreen')"]},
    {"id": "esc_SaveScreen_7", "say": "Esc cierra SaveScreen", "key": "Escape", "expect": ["not q.visible('SaveScreen')"], "soft": true},
    {"id": "esc_pausa_7", "say": "y Esc otra vez cierra el menú de pausa", "key": "Escape", "expect": ["not q.menu()"], "soft": true},
    {"id": "reinicio_8", "restart": {"scenario": "town_e_start"}},
    {"key": "F9", "id": "abre_SaveScreen_8", "say": "Abrir SaveScreen", "expect": ["q.visible('SaveScreen')"]},
    {"id": "esc_SaveScreen_8", "say": "Esc cierra SaveScreen", "key": "Escape", "expect": ["not q.visible('SaveScreen')"], "soft": true},
    {"id": "esc_pausa_8", "say": "y Esc otra vez cierra el menú de pausa", "key": "Escape", "expect": ["not q.menu()"], "soft": true},
    {"id": "reinicio_9", "restart": {"scenario": "town_e_start"}},
    {"world": {"service": "board"}, "button": "right", "until": "q.visible('BoardPanel')", "timeout": 30, "fast": 4, "id": "abre_BoardPanel_9", "say": "Abrir BoardPanel", "expect": ["q.visible('BoardPanel')"]},
    {"id": "esc_BoardPanel_9", "say": "Esc cierra BoardPanel", "key": "Escape", "expect": ["not q.visible('BoardPanel')"], "soft": true},
    {"id": "reinicio_10", "restart": {"scenario": "town_e_start"}},
    {"world": {"service": "resources"}, "button": "right", "until": "q.visible('MarketPanel')", "timeout": 30, "fast": 4, "id": "abre_MarketPanel_10", "say": "Abrir MarketPanel", "expect": ["q.visible('MarketPanel')"]},
    {"id": "esc_MarketPanel_10", "say": "Esc cierra MarketPanel", "key": "Escape", "expect": ["not q.visible('MarketPanel')"], "soft": true},
    {"id": "reinicio_11", "restart": {"scenario": "town_e_start"}},
    {"world": {"service": "town_hall"}, "button": "right", "until": "q.visible('TownHallPanel')", "timeout": 30, "fast": 4, "id": "abre_TownHallPanel_11", "say": "Abrir TownHallPanel", "expect": ["q.visible('TownHallPanel')"]},
    {"id": "esc_TownHallPanel_11", "say": "Esc cierra TownHallPanel", "key": "Escape", "expect": ["not q.visible('TownHallPanel')"], "soft": true},
    {"id": "reinicio_12", "restart": {"scenario": "town_e_start"}},
    {"id": "pausa_vecino", "say": "Espacio: pausa (el vecino anda)", "key": "Space"},
    {"world": {"person": "=q.npc_near()"}, "id": "abre_NpcPanel_12", "say": "Abrir la ficha de un vecino (clic en él)", "expect": ["q.visible('NpcPanel')"]},
    {"id": "esc_NpcPanel_12", "say": "Esc cierra NpcPanel", "key": "Escape", "expect": ["not q.visible('NpcPanel')"], "soft": true},
    {"id": "reinicio_int", "restart": {"scenario": "town_e_start"}},
    {"id": "forja", "world": {"own": "forge"}, "double": true, "until": "q.interior() != ''", "timeout": 6},
    {"id": "abre_ProductionPanel", "key": "@panel_production", "expect": ["q.visible('ProductionPanel')"]},
    {"id": "esc_ProductionPanel", "key": "Escape", "expect": ["not q.visible('ProductionPanel')", "q.interior() != ''"], "soft": true},
    {"id": "abre_StoragePanel", "key": "@panel_storage", "expect": ["q.visible('StoragePanel')"]},
    {"id": "esc_StoragePanel", "key": "Escape", "expect": ["not q.visible('StoragePanel')", "q.interior() != ''"], "soft": true},
    {"id": "abre_StaffPanel", "key": "@panel_staff", "expect": ["q.visible('StaffPanel')"]},
    {"id": "esc_StaffPanel", "key": "Escape", "expect": ["not q.visible('StaffPanel')", "q.interior() != ''"], "soft": true},
    {"id": "abre_UpgradePanel", "key": "@panel_upgrades", "expect": ["q.visible('UpgradePanel')"]},
    {"id": "esc_UpgradePanel", "key": "Escape", "expect": ["not q.visible('UpgradePanel')", "q.interior() != ''"], "soft": true},
    {"id": "menu_puesto", "say": "El menú de un puesto (clic derecho)", "station": "anvil", "button": "right", "expect": ["q.visible('StationMenu')"]},
    {"id": "esc_menu_puesto", "key": "Escape", "expect": ["not q.visible('StationMenu')"], "soft": true},
    {"id": "esc_sale", "say": "Esc con nada abierto dentro: sale a la ciudad", "key": "Escape", "until": "q.interior() == ''", "timeout": 6, "soft": true},
    {"id": "titulo", "restart": {"title": true}},
    {"id": "opciones", "click": {"node": "OptionsButton"}, "expect": ["q.visible('OptionsScreen')"]},
    {"id": "esc_opciones", "key": "Escape", "expect": ["not q.visible('OptionsScreen')"], "soft": true},
    {"id": "creditos", "click": {"node": "CreditsButton"}, "expect": ["q.visible('CreditsScreen')"]},
    {"id": "esc_creditos", "key": "Escape", "expect": ["not q.visible('CreditsScreen')"], "soft": true},
    {"id": "cargar", "click": {"within": "TitleScreen", "node": "LoadButton"}, "soft": true},
    {"id": "esc_cargar", "when": "q.visible('SaveScreen')", "key": "Escape", "expect": ["not q.visible('SaveScreen')"], "soft": true},
    {"id": "nueva", "click": {"node": "NewGameButton"}, "expect": ["q.visible('NewGameScreen')"]},
    {"id": "esc_nueva", "key": "Escape", "expect": ["not q.visible('NewGameScreen')"], "soft": true, "say": "Esc cierra la partida nueva (con el foco en el campo del nombre)"},
    {"id": "esc_nueva_2", "say": "Si no, un segundo Esc", "when": "q.visible('NewGameScreen')", "key": "Escape", "expect": ["not q.visible('NewGameScreen')"], "soft": true}
  ]
}
