{
  "id": "cortejo_boda",
  "title": "Cortejar y boda",
  "about": "Hugo, soltero, con 76 de afinidad con Agnès: el inventario (I) → Cortejar, una conversación sube la afinidad a 80, «Proponer» pregunta y la boda llega con su carta.",
  "start": {"scenario": "courtship"},
  "covers": ["court_talk", "court_gift", "propose"],
  "steps": [
    {"id": "ficha", "say": "I: la ficha del personaje", "key": "@inventory", "expect": ["q.visible('CharacterPanel')"]},
    {"id": "cortejar", "say": "El botón Cortejar de la ficha", "click": {"node": "CourtButton"}, "expect": ["q.visible('CourtshipPanel')"]},
    {"id": "hablar", "say": "Hablar con la primera candidata", "click": {"within": "CourtshipPanel", "node": "Talk"}, "until": "q.event('affinity_changed') or q.refused() != ''", "timeout": 20, "fast": 4, "expect": ["q.order('court_talk')"]},
    {"id": "proponer", "say": "Proponer: pide confirmación", "click": {"within": "CourtshipPanel", "node": "Propose"}, "expect": ["q.visible('ConfirmModal')"]},
    {"id": "si", "say": "Sí, proponer", "click": {"within": "ConfirmModal", "node": "ConfirmButton"}, "until": "q.married() or q.refused() != ''", "timeout": 20, "fast": 4, "expect": ["q.order('propose')", "q.married()"]},
    {"id": "carta_boda", "say": "La carta de la boda", "until": "q.visible('WeddingCard')", "timeout": 8},
    {"id": "cerrar_carta", "say": "Cerrarla", "click": {"within": "WeddingCard", "prefix": "Button_"}, "soft": true},
    {"id": "esc", "key": "Escape"}
  ]
}
