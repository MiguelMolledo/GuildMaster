{
  "id": "tratados",
  "title": "Tratados y encargos de fuera",
  "about": "Barón y alcalde (escenario patron_treaties): el tratado del pueblo desde la ficha de la aldea (en pausa: el botón y la tira dicen que espera; al correr el reloj vota el concejo y llega su carta), el viaje, aceptar y entregar un encargo de la ciudad, firmar y cancelar un tratado de la familia y la vuelta.",
  "start": {"scenario": "patron_treaties"},
  "covers": ["propose_town_treaty", "travel", "city_accept", "city_deliver", "sign_treaty", "cancel_treaty", "return", "buy_cart"],
  "steps": [
    {"id": "region", "say": "R: el mapa de la región", "key": "@region_map", "expect": ["q.visible('RegionScreen')"]},
    {"id": "aldea", "say": "Clic en la aldea: su ficha", "click": {"node": "Marker_hamlet"}, "expect": ["q.visible('SettlementCard')"]},
    {"id": "tratado_pueblo", "say": "«Tratado de la villa» (el alcalde lo lleva al concejo; con el mapa en pausa se aplica al seguir el reloj)", "click": {"within": "SettlementCard", "node": "Button_town_treaty", "enabled": true}, "expect": ["q.order('propose_town_treaty')"]},
    {"id": "tratado_espera", "say": "Al momento: el botón dice «Firmando… (al reanudar)» y la orden sale en la tira de la cola del mapa", "expect": ["q.shown({'within': 'SettlementCard', 'tr': 'ui.region.town_treaty_waiting'})", "q.disabled({'within': 'SettlementCard', 'node': 'Button_town_treaty'})", "q.visible('PendingStrip')", "q.has_text('al reanudar')", "q.treaties() == 0"]},
    {"id": "esc_ficha", "say": "Esc cierra la ficha", "key": "Escape"},
    {"id": "esc_mapa_reloj", "say": "Esc cierra el mapa: el reloj corre y el concejo vota", "key": "Escape", "until": "q.treaties() > 0", "timeout": 10, "expect": ["not q.visible('RegionScreen')"]},
    {"id": "fiesta_fuera", "say": "Las cartas de la fiesta que esperaban delante (pregón y comienzo): Entendido", "when": "q.shown({'within': 'EventCard', 'node': 'Button_ok'}) and not str(q.drv.node('EventCard').data.get('event', '')).begins_with('council')", "click": {"within": "EventCard", "node": "Button_ok"}, "wait": 0.5},
    {"id": "fiesta_fuera_2", "when": "q.shown({'within': 'EventCard', 'node': 'Button_ok'}) and not str(q.drv.node('EventCard').data.get('event', '')).begins_with('council')", "click": {"within": "EventCard", "node": "Button_ok"}, "wait": 0.5},
    {"id": "carta_concejo", "say": "La carta del concejo (las de la fiesta que ya esperaban van antes: se cierran con Entendido)", "until": "q.shown({'within': 'EventCard', 'node': 'Button_ok'}) and str(q.drv.node('EventCard').data.get('event', '')).begins_with('council')", "timeout": 30, "fast": 2},
    {"id": "carta_concejo_ok", "click": {"within": "EventCard", "node": "Button_ok"}, "expect": ["not q.shown({'within': 'EventCard', 'node': 'Button_ok'}) or not str(q.drv.node('EventCard').data.get('event', '')).begins_with('council')"]},
    {"id": "region_2", "say": "R: otra vez el mapa", "key": "@region_map", "expect": ["q.visible('RegionScreen')"]},
    {"id": "aldea_2", "say": "Clic en la aldea", "click": {"node": "Marker_hamlet"}, "expect": ["q.visible('SettlementCard')"]},
    {"id": "viajar", "say": "«Viajar»", "click": {"within": "SettlementCard", "node": "Button_travel"}, "until": "q.away() or q.trips() > 0", "timeout": 8, "expect": ["q.order('travel')"]},
    {"id": "x4", "key": "@speed_3"},
    {"id": "llegada", "say": "Al llegar se abre la página de la ciudad", "until": "q.visible('CityScreen')", "timeout": 90, "fast": 8},
    {"id": "encargos", "say": "Pestaña Encargos", "click": {"node": "Tab_board"}},
    {"id": "aceptar", "say": "Aceptar el encargo del tablón", "click": {"within": "CityScreen", "tr": "ui.city.accept", "enabled": true}, "expect": ["q.order('city_accept')"]},
    {"id": "espera_entregar", "say": "La página se pone al día: el encargo aceptado", "until": "q.shown({'within': 'CityScreen', 'tr': 'ui.city.deliver', 'enabled': true})", "timeout": 6},
    {"id": "entregar", "say": "Entregarlo (lo lleva en la bolsa)", "click": {"within": "CityScreen", "tr": "ui.city.deliver", "enabled": true}, "expect": ["q.order('city_deliver')", "q.gold() > q.was('gold')"]},
    {"id": "tratados", "say": "Pestaña Tratados", "click": {"node": "Tab_treaties"}},
    {"id": "firmar", "say": "Firmar el primero que se pueda", "click": {"within": "CityScreen", "text": "Firmar", "enabled": true}, "expect": ["q.order('sign_treaty')", "q.treaties() > q.was('treaties')"]},
    {"id": "espera_cancelar", "until": "q.shown({'within': 'CityScreen', 'tr': 'ui.city.cancel', 'enabled': true})", "timeout": 6},
    {"id": "cancelar", "say": "Cancelar un tratado propio", "click": {"within": "CityScreen", "tr": "ui.city.cancel", "enabled": true}, "expect": ["q.order('cancel_treaty')", "q.treaties() < q.was('treaties')"]},
    {"id": "volver", "say": "«Volver a casa»", "click": {"node": "ReturnButton"}, "expect": ["q.order('return')"]},
    {"id": "de_vuelta", "say": "Hasta casa", "until": "not q.away()", "timeout": 90, "fast": 8},
    {"id": "esc_mapa", "when": "q.visible('RegionScreen')", "key": "Escape"},
    {"id": "esc_mapa_2", "when": "q.visible('RegionScreen')", "key": "Escape", "expect": ["not q.visible('RegionScreen')"]},
    {"id": "pausa", "say": "Espacio: pausa (si el mapa no la puso)", "when": "not q.paused()", "key": "Space", "expect": ["q.paused()"]},
    {"id": "region_3", "say": "El mapa otra vez, en pausa", "key": "@region_map", "expect": ["q.visible('RegionScreen')", "q.paused()"]},
    {"id": "caravanas", "click": {"node": "CaravansButton"}, "expect": ["q.visible('CaravanScreen')"]},
    {"id": "carro", "say": "Comprar un carro en pausa: el botón dice «Comprando un carro… (al reanudar)» y sale en la tira", "click": {"node": "BuyCartButton", "enabled": true}, "until": "q.shown({'within': 'CaravanScreen', 'tr': 'ui.caravan.buy_cart_waiting'})", "timeout": 4, "expect": ["q.order('buy_cart')", "q.shown({'within': 'CaravanScreen', 'node': 'PendingStrip'})", "q.carts() == 0"]},
    {"id": "caravanas_atras", "click": {"within": "CaravanScreen", "node": "BackButton"}, "expect": ["not q.visible('CaravanScreen')"]},
    {"id": "cerrar_mapa_carro", "say": "Esc cierra el mapa (vuelve la pausa que había)", "key": "Escape", "expect": ["not q.visible('RegionScreen')", "q.carts() == 0"]},
    {"id": "reanudar_carro", "say": "Espacio: el reloj corre y se compra el carro", "key": "Space", "until": "q.carts() > 0", "timeout": 8}
  ]
}
