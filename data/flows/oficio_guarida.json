{
  "id": "oficio_guarida",
  "title": "Oficio: guarida en 3D",
  "about": "Partida nueva de ladrón: robar la bolsa a un vecino en la calle, entrar en la guarida (abierta en sitio) y abrir el perista y el banco de blanquear.",
  "view": "3d",
  "start": {
    "start": "rogue_thief",
    "at": "11:00",
    "seed": 1
  },
  "covers": [
    "pickpocket",
    "burgle",
    "fence_sell",
    "enter_building",
    "exit_building"
  ],
  "steps": [
    {
      "id": "calle",
      "say": "La calle: espera a alguien parado al que robar",
      "until": "q.victim() != ''",
      "timeout": 30,
      "fast": 4
    },
    {
      "id": "pausa",
      "say": "Espacio: pausa (que nadie se cruce al apuntar)",
      "key": "@pause_toggle",
      "expect": [
        "q.paused()"
      ]
    },
    {
      "id": "vecino",
      "say": "Clic en el vecino más cercano al que se puede robar: su ficha",
      "world": {
        "person": "=q.victim()"
      },
      "expect": [
        "q.visible('NpcPanel')"
      ]
    },
    {
      "id": "guardar_oro",
      "expect": [
        "q.keep('oro', q.gold())"
      ]
    },
    {
      "id": "seguir",
      "say": "Espacio: sigue el tiempo",
      "key": "@pause_toggle",
      "expect": [
        "not q.paused()"
      ]
    },
    {
      "id": "robar",
      "say": "Robarle la bolsa",
      "click": {
        "within": "NpcPanel",
        "node": "Pickpocket"
      },
      "until": "q.event('pickpocket_done') or q.event('pickpocket_failed')",
      "timeout": 30,
      "fast": 4,
      "expect": [
        "q.order('pickpocket') or q.order('move_to')"
      ]
    },
    {
      "id": "botin",
      "say": "El oro de la bolsa",
      "expect": [
        "q.gold() > q.kept('oro')"
      ]
    },
    {
      "id": "cerrar_ficha",
      "key": "Escape"
    },
    {
      "id": "entrar",
      "say": "Clic derecho en la guarida: entra",
      "world": {
        "own": "den"
      },
      "button": "right",
      "until": "q.interior() == q.own('den') and q.location() == q.own('den')",
      "timeout": 30,
      "fast": 4,
      "expect": [
        "q.order('enter_building')"
      ]
    },
    {
      "id": "en_sitio",
      "say": "La casa se abre en sitio: sus puestos y su gente dentro",
      "until": "q.in_place3d()",
      "timeout": 10,
      "expect": [
        "q.stations3d() == q.zones()",
        "q.seen3d()"
      ]
    },
    {
      "id": "menu_perista",
      "say": "Clic derecho en el perista: su menú",
      "station": "fence",
      "button": "right",
      "expect": [
        "q.visible('StationMenu')"
      ]
    },
    {
      "id": "cerrar_perista",
      "key": "Escape",
      "expect": [
        "not q.visible('StationMenu')"
      ]
    },
    {
      "id": "menu_banco",
      "say": "Clic derecho en el banco de blanquear",
      "station": "forger_bench",
      "button": "right",
      "expect": [
        "q.visible('StationMenu')"
      ]
    },
    {
      "id": "cerrar_banco",
      "key": "Escape",
      "expect": [
        "not q.visible('StationMenu')"
      ]
    },
    {
      "id": "salir",
      "say": "Salir",
      "click": {
        "node": "ExitButton"
      },
      "until": "q.interior() == '' and q.location() == ''",
      "timeout": 20,
      "fast": 4
    },
    {
      "id": "velocidad",
      "say": "Mayús+3: ×4",
      "key": "@speed_3",
      "expect": [
        "q.speed() == 4"
      ]
    },
    {
      "id": "noche",
      "say": "Espera a la noche: hay una casa ajena con algo que robar",
      "until": "q.burglable() != ''",
      "timeout": 60,
      "fast": 6
    },
    {
      "id": "velocidad_1n",
      "key": "@speed_1"
    },
    {
      "id": "pausa_n",
      "say": "Espacio: pausa para apuntar",
      "key": "@pause_toggle",
      "expect": [
        "q.paused()"
      ]
    },
    {
      "id": "casa",
      "say": "Clic en la casa: su barra",
      "world": {
        "building": "=q.burglable()"
      },
      "expect": [
        "q.shown({'node': 'BurgleButton'})"
      ]
    },
    {
      "id": "seguir_n",
      "key": "@pause_toggle",
      "expect": [
        "not q.paused()"
      ]
    },
    {
      "id": "robar_casa",
      "say": "«Robar en la casa»: va a su puerta y entra",
      "click": {
        "node": "BurgleButton"
      },
      "expect": [
        "q.order('burgle')"
      ]
    },
    {
      "id": "robando",
      "say": "Espera a que entre y salga con algo",
      "until": "q.event('burgle_done') or q.event('burgle_failed') or q.stolen() > 0",
      "timeout": 40,
      "fast": 4
    },
    {
      "id": "botin_casa",
      "say": "Lo robado, en la bolsa",
      "until": "q.stolen() > 0",
      "timeout": 10,
      "fast": 4
    },
    {
      "id": "a_la_guarida",
      "say": "De vuelta a la guarida",
      "world": {
        "own": "den"
      },
      "button": "right",
      "until": "q.interior() == q.own('den') and q.location() == q.own('den')",
      "timeout": 40,
      "fast": 4
    },
    {
      "id": "perista",
      "say": "Clic derecho en el perista",
      "station": "fence",
      "button": "right",
      "expect": [
        "q.visible('StationMenu')"
      ]
    },
    {
      "id": "vender_perista",
      "say": "Venderle lo robado",
      "click": {
        "within": "StationMenu",
        "prefix": "Fence_"
      },
      "until": "q.stolen() < q.was('stolen')",
      "timeout": 10,
      "expect": [
        "q.order('fence_sell')",
        "q.gold() > q.was('gold')"
      ]
    },
    {
      "id": "salir_2",
      "say": "Salir",
      "click": {
        "node": "ExitButton"
      },
      "until": "q.interior() == '' and q.location() == ''",
      "timeout": 20,
      "fast": 4
    }
  ]
}
