{
  "id": "jugador/06_calidad",
  "title": "Jugador 6 · Las cartas «Nuevo» y un encargo de calidad buena",
  "about": "Día 2, con la fiesta: las cartas que se juntaron y el objetivo de un encargo de calidad «buena»: la espada del capitán, forjada a mano.",
  "start": {
    "keep": true
  },
  "steps": [
    {
      "id": "a_carta_1",
      "say": "Una carta «Nuevo»: leerla y Entendido",
      "when": "q.shown({'within': 'UnlockCard', 'node': 'Button_ok'}) and not q.shown({'within': 'UnlockCard', 'node': 'Button_chapter'})",
      "click": {
        "within": "UnlockCard",
        "node": "Button_ok"
      },
      "wait": 0.4
    },
    {
      "id": "a_carta_2",
      "say": "",
      "when": "q.shown({'within': 'UnlockCard', 'node': 'Button_ok'}) and not q.shown({'within': 'UnlockCard', 'node': 'Button_chapter'})",
      "click": {
        "within": "UnlockCard",
        "node": "Button_ok"
      },
      "wait": 0.4
    },
    {
      "id": "a_carta_3",
      "say": "",
      "when": "q.shown({'within': 'UnlockCard', 'node': 'Button_ok'}) and not q.shown({'within': 'UnlockCard', 'node': 'Button_chapter'})",
      "click": {
        "within": "UnlockCard",
        "node": "Button_ok"
      },
      "wait": 0.4
    },
    {
      "id": "a_evento_1",
      "say": "Una carta de fiesta o de suceso: leerla y Entendido",
      "when": "q.shown({'within': 'EventCard', 'node': 'Button_ok'})",
      "click": {
        "within": "EventCard",
        "node": "Button_ok"
      },
      "wait": 0.4
    },
    {
      "id": "a_evento_2",
      "say": "",
      "when": "q.shown({'within': 'EventCard', 'node': 'Button_ok'})",
      "click": {
        "within": "EventCard",
        "node": "Button_ok"
      },
      "wait": 0.4
    },
    {
      "id": "objetivo",
      "say": "El objetivo: un encargo de calidad buena",
      "expect": [
        "q.has_text('calidad')"
      ],
      "soft": true
    },
    {
      "id": "tablon",
      "say": "Al tablón",
      "world": {
        "service": "board"
      },
      "button": "right",
      "until": "q.visible('BoardPanel')",
      "timeout": 40
    },
    {
      "id": "aceptar_espada",
      "say": "La espada «calidad buena o mejor» del capitán",
      "when": "q.board_id('sword') != ''",
      "click": {
        "within": {
          "node": "='Note_' + q.board_id('sword')"
        },
        "node": "Accept"
      },
      "expect": [
        "q.order('accept_contract')"
      ]
    },
    {
      "id": "esc_tablon",
      "key": "Escape"
    },
    {
      "id": "b_scerrar_panel",
      "when": "q.visible('StoragePanel') or q.visible('ProductionPanel') or q.visible('StationMenu')",
      "key": "Escape"
    },
    {
      "id": "b_ssalir",
      "when": "q.interior() != ''",
      "click": {
        "node": "ExitButton"
      },
      "until": "q.interior() == ''",
      "timeout": 20
    },
    {
      "id": "b_espera_mercado",
      "say": "De noche el puesto cierra: esperar a que abra (×4)",
      "when": "q.storage('iron') < 4 and q.gold() >= 30 and not q.market_open('resources')",
      "key": "@speed_3",
      "until": "q.market_open('resources')",
      "timeout": 120
    },
    {
      "id": "b_hierro_falta",
      "say": "Queda poco hierro: al puesto de Recursos con recado",
      "when": "q.storage('iron') < 4 and q.gold() >= 30",
      "world": {
        "service": "resources"
      },
      "button": "right",
      "until": "q.visible('MarketPanel')",
      "timeout": 40
    },
    {
      "id": "b_hierro_mas",
      "say": "Tantos como dé el oro (4, u 8 con la bolsa llena)",
      "when": "q.visible('MarketPanel')",
      "click": {
        "within": {
          "within": "BuyList",
          "prefix": "iron_"
        },
        "node": "Plus"
      },
      "times": 3
    },
    {
      "id": "b_hierro_mas_8",
      "when": "q.visible('MarketPanel') and q.gold() >= 90",
      "click": {
        "within": {
          "within": "BuyList",
          "prefix": "iron_"
        },
        "node": "Plus"
      },
      "times": 0
    },
    {
      "id": "b_hierro_enviar",
      "when": "q.visible('MarketPanel')",
      "click": {
        "within": {
          "within": "BuyList",
          "prefix": "iron_"
        },
        "node": "Send"
      }
    },
    {
      "id": "b_hierro_destino",
      "when": "q.visible('MarketPanel')",
      "popup": {
        "within": {
          "within": "BuyList",
          "prefix": "iron_"
        },
        "node": "Send"
      },
      "item": 0,
      "expect": [
        "q.order('buy')"
      ],
      "soft": true
    },
    {
      "id": "b_hierro_reintento",
      "say": "El menú no cogió el clic: otra vez",
      "when": "q.visible('MarketPanel') and not q.order('buy')",
      "click": {
        "within": {
          "within": "BuyList",
          "prefix": "iron_"
        },
        "node": "Send"
      }
    },
    {
      "id": "b_hierro_destino_2",
      "when": "q.visible('MarketPanel') and not q.order('buy')",
      "popup": {
        "within": {
          "within": "BuyList",
          "prefix": "iron_"
        },
        "node": "Send"
      },
      "item": 0,
      "soft": true
    },
    {
      "id": "b_carbon_mas",
      "when": "q.visible('MarketPanel') and q.storage('coal') < 3",
      "click": {
        "within": {
          "within": "BuyList",
          "prefix": "coal_"
        },
        "node": "Plus"
      },
      "times": 2
    },
    {
      "id": "b_carbon_enviar",
      "when": "q.visible('MarketPanel') and q.storage('coal') < 3",
      "click": {
        "within": {
          "within": "BuyList",
          "prefix": "coal_"
        },
        "node": "Send"
      }
    },
    {
      "id": "b_carbon_destino",
      "when": "q.visible('MarketPanel') and q.storage('coal') < 3",
      "popup": {
        "within": {
          "within": "BuyList",
          "prefix": "coal_"
        },
        "node": "Send"
      },
      "item": 0
    },
    {
      "id": "b_cerrar_puesto",
      "when": "q.visible('MarketPanel')",
      "key": "Escape"
    },
    {
      "id": "c_a_la_forja",
      "say": "A la forja",
      "when": "q.interior() != q.own('forge')",
      "world": {
        "own": "forge"
      },
      "button": "right",
      "until": "q.interior() == q.own('forge') and q.location() == q.own('forge')",
      "timeout": 40
    },
    {
      "id": "horno",
      "say": "Dos lingotes en el horno",
      "when": "q.storage('iron_ingot') < 2",
      "station": "furnace",
      "button": "right",
      "expect": [
        "q.visible('StationMenu')"
      ]
    },
    {
      "id": "horno_b",
      "when": "q.visible('StationMenu')",
      "click": {
        "via": "RecipeList",
        "fn": "get_node",
        "args": [
          "Row_forge_ingot"
        ],
        "type": "Button"
      }
    },
    {
      "id": "x4",
      "key": "@speed_3"
    },
    {
      "id": "espera_lingotes",
      "when": "q.storage('iron_ingot') < 2",
      "until": "q.storage('iron_ingot') >= 2",
      "timeout": 150
    },
    {
      "id": "yunque",
      "say": "El yunque en Forja viva",
      "station": "anvil",
      "button": "right",
      "expect": [
        "q.visible('StationMenu')"
      ]
    },
    {
      "id": "viva",
      "click": {
        "node": "CarefulButton"
      }
    },
    {
      "id": "espada",
      "click": {
        "via": "RecipeList",
        "fn": "get_node",
        "args": [
          "Row_forge_sword"
        ],
        "type": "Button"
      },
      "until": "q.live_open()",
      "timeout": 30
    },
    {
      "id": "calentar",
      "until": "q.live_heat_ok()",
      "timeout": 30
    },
    {
      "id": "sacar",
      "click": {
        "node": "PullButton"
      }
    },
    {
      "id": "golpe_espera",
      "until": "q.live_stage() == 'strike'",
      "timeout": 8
    },
    {
      "id": "golpe_1",
      "when": "q.live_stage() == 'strike'",
      "click": {
        "node": "='Strike_' + q.live_strike()"
      }
    },
    {
      "id": "golpe_2",
      "when": "q.live_stage() == 'strike'",
      "click": {
        "node": "='Strike_' + q.live_strike()"
      }
    },
    {
      "id": "golpe_3",
      "when": "q.live_stage() == 'strike'",
      "click": {
        "node": "='Strike_' + q.live_strike()"
      }
    },
    {
      "id": "golpe_4",
      "when": "q.live_stage() == 'strike'",
      "click": {
        "node": "='Strike_' + q.live_strike()"
      }
    },
    {
      "id": "golpe_5",
      "when": "q.live_stage() == 'strike'",
      "click": {
        "node": "='Strike_' + q.live_strike()"
      }
    },
    {
      "id": "golpe_6",
      "when": "q.live_stage() == 'strike'",
      "click": {
        "node": "='Strike_' + q.live_strike()"
      }
    },
    {
      "id": "templar_espera",
      "until": "q.live_stage() == 'quench'",
      "timeout": 8
    },
    {
      "id": "templar",
      "click": {
        "node": "='Quench_' + q.live_quench()"
      }
    },
    {
      "id": "resultado",
      "say": "La pieza termina sola",
      "until": "q.storage('sword') > 0",
      "timeout": 90
    },
    {
      "id": "cerrar_viva",
      "when": "q.live_open()",
      "click": {
        "within": "LiveForgeScreen",
        "node": "CloseButton"
      }
    },
    {
      "id": "esc_menu",
      "when": "q.visible('StationMenu')",
      "key": "Escape"
    },
    {
      "id": "almacen",
      "key": "@panel_storage",
      "expect": [
        "q.visible('StoragePanel')"
      ]
    },
    {
      "id": "coger",
      "click": {
        "within": "BuildingGrid",
        "prefix": "sword_"
      },
      "until": "q.bag('sword') > 0",
      "timeout": 8
    },
    {
      "id": "d_cerrar_panel",
      "when": "q.visible('StoragePanel') or q.visible('ProductionPanel') or q.visible('StationMenu')",
      "key": "Escape"
    },
    {
      "id": "d_salir",
      "when": "q.interior() != ''",
      "click": {
        "node": "ExitButton"
      },
      "until": "q.interior() == ''",
      "timeout": 20
    },
    {
      "id": "tablon_2",
      "world": {
        "service": "board"
      },
      "button": "right",
      "until": "q.visible('BoardPanel')",
      "timeout": 40
    },
    {
      "id": "entregar",
      "say": "Entregar la espada de calidad",
      "when": "q.mine_id('sword') != ''",
      "click": {
        "within": {
          "node": "='Row_' + q.mine_id('sword')"
        },
        "node": "Deliver"
      },
      "expect": [
        "q.order('deliver_contract')"
      ],
      "soft": true
    },
    {
      "id": "esc_tablon_2",
      "key": "Escape"
    }
  ]
}