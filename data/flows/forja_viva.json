{
  "id": "forja_viva",
  "title": "Forjar a mano: la Forja viva",
  "about": "Hugo en su forja con lo que pide la espada (escenario forge_live_ready): el yunque en modo «Viva», calentar hasta el color que pide la receta y sacar, batir los golpes de la plantilla, templar en su medio, el resultado; luego parar para no forjar otra.",
  "start": {"scenario": "forge_live_ready"},
  "covers": ["live_forge", "work_at", "stop_work"],
  "steps": [
    {"id": "a_la_forja", "world": {"own": "forge"}, "button": "right", "until": "q.interior() == q.own('forge') and q.location() == q.own('forge')", "timeout": 30, "fast": 4},
    {"id": "menu_yunque", "station": "anvil", "button": "right", "expect": ["q.visible('StationMenu')"]},
    {"id": "modo_viva", "say": "Modo «Viva» (Forja viva): la espada a mano", "click": {"node": "CarefulButton"}},
    {"id": "receta_espada", "say": "La espada", "click": {"via": "RecipeList", "fn": "get_node", "args": ["Row_forge_sword"], "type": "Button"}, "until": "q.live_open()", "timeout": 20, "fast": 4, "expect": ["q.order('work_at')"]},
    {"id": "calentar", "say": "Calentar: el hierro cambia de color; se saca al color que pide", "until": "q.live_heat_ok()", "timeout": 20},
    {"id": "sacar", "say": "«Sacar»", "click": {"node": "PullButton"}, "expect": ["q.order('live_forge')"]},
    {"id": "golpe_1", "say": "Batir: el golpe que marca la plantilla", "until": "q.live_stage() == 'strike'", "timeout": 6},
    {"id": "golpe_1b", "click": {"node": "='Strike_' + q.live_strike()"}},
    {"id": "golpe_2", "when": "q.live_stage() == 'strike'", "click": {"node": "='Strike_' + q.live_strike()"}},
    {"id": "golpe_3", "when": "q.live_stage() == 'strike'", "click": {"node": "='Strike_' + q.live_strike()"}},
    {"id": "golpe_4", "when": "q.live_stage() == 'strike'", "click": {"node": "='Strike_' + q.live_strike()"}},
    {"id": "templar", "say": "Templar en el medio que pide", "until": "q.live_stage() == 'quench'", "timeout": 6},
    {"id": "templar_b", "click": {"node": "='Quench_' + q.live_quench()"}},
    {"id": "resultado", "say": "El resultado: la calidad y lo que dieron las decisiones", "until": "q.storage('sword') > 0", "timeout": 60, "fast": 6},
    {"id": "parar_viva", "say": "Para no forjar otra a mano: clic derecho en el yunque y Parar", "when": "q.live_open()", "station": "anvil", "button": "right", "soft": true},
    {"id": "parar_viva_b", "when": "q.visible('StationMenu')", "click": {"node": "StopButton"}, "expect": ["q.order('stop_work')"]},
    {"id": "cerrar_forja", "say": "Cerrar la pantalla de la Forja viva", "when": "q.live_open()", "click": {"within": "LiveForgeScreen", "node": "CloseButton"}, "expect": ["not q.live_open()"]}
  ]
}
