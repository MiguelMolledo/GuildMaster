{
  "id": "gestion_a_fondo",
  "title": "Gestión a fondo",
  "about": "La forja con dos empleados: el puesto de cada empleado, la gratificación y el despido; la cola (añadir, subir, quitar, parar a quien trabaja); el equipo de la persona (quitar y poner); el libro de avisos; abandonar un encargo; y, aparte, aceptar el ascenso de una aprendiz.",
  "start": {"scenario": "two_employees"},
  "covers": ["set_role", "bonus", "fire", "queue_move", "queue_remove", "stop_work", "unequip", "equip", "read_notices", "abandon_contract", "promote"],
  "steps": [
    {"id": "gestion", "world": {"own": "forge"}, "double": true, "until": "q.interior() == q.own('forge')", "timeout": 6},
    {"id": "empleados", "key": "@panel_staff", "expect": ["q.visible('StaffPanel')"]},
    {"id": "plantilla", "click": {"node": "StaffTab"}},
    {"id": "puesto", "say": "El puesto del primer empleado: «Cualquiera»", "click": {"within": "List", "node": "any", "index": 0}, "expect": ["q.order('set_role')"]},
    {"id": "gratificar", "say": "Gratificar", "click": {"within": "List", "node": "Bonus"}, "until": "q.order('bonus') or q.visible('ConfirmModal')", "timeout": 4},
    {"id": "gratificar_si", "when": "q.visible('ConfirmModal')", "click": {"within": "ConfirmModal", "node": "ConfirmButton"}, "expect": ["q.order('bonus')"]},
    {"id": "despedir", "say": "Despedir: pide confirmación", "click": {"within": "List", "node": "Fire", "index": 1}, "expect": ["q.visible('ConfirmModal')"]},
    {"id": "despedir_si", "click": {"within": "ConfirmModal", "node": "ConfirmButton"}, "until": "q.event('employee_fired')", "timeout": 6, "expect": ["q.order('fire')"], "say": "Confirmar: se va al final del día"},
    {"id": "produccion", "key": "@panel_production", "expect": ["q.visible('ProductionPanel')"]},
    {"id": "ahora", "say": "Pestaña Ahora: parar a quien trabaja", "click": {"node": "NowTab"}},
    {"id": "parar", "when": "q.shown({'within': 'Stations', 'node': 'Stop', 'enabled': true})", "click": {"within": "Stations", "node": "Stop", "enabled": true}, "expect": ["q.order('stop_work')"]},
    {"id": "cola", "click": {"node": "QueueTab"}},
    {"id": "lingote", "click": {"within": "RecipeGrid", "node": "forge_ingot"}},
    {"id": "mas_1", "click": {"node": "Add1"}, "until": "q.order('queue_add')", "timeout": 4},
    {"id": "subir", "say": "↑ sube la última entrada", "click": {"within": "QueueList", "node": "Up", "enabled": true, "index": 0}, "expect": ["q.order('queue_move')"]},
    {"id": "quitar", "say": "x quita una entrada", "click": {"within": "QueueList", "node": "Remove"}, "expect": ["q.order('queue_remove')"]},
    {"id": "esc_panel", "key": "Escape"},
    {"id": "esc_sale", "key": "Escape", "until": "q.interior() == ''", "timeout": 6},
    {"id": "equipo_escena", "say": "El equipo, en una partida nueva (empieza con herramienta equipada)", "restart": {"new_game": true}},
    {"id": "sin_tutorial", "click": {"node": "TutorialCheck"}},
    {"id": "empezar", "click": {"node": "StartButton"}, "until": "not q.visible('NewGameScreen') and q.fam() != ''", "timeout": 6},
    {"id": "ficha", "key": "@inventory", "expect": ["q.visible('CharacterPanel')"]},
    {"id": "poner_equipo", "say": "Equipar algo de la bolsa (si lleva algo equipable)", "when": "q.shown({'within': 'CharacterPanel', 'node': 'Equip'})", "click": {"within": "CharacterPanel", "node": "Equip"}, "expect": ["q.order('equip')"]},
    {"id": "quitar_equipo", "say": "Quitar lo equipado", "when": "q.shown({'within': 'CharacterPanel', 'node': 'Unequip'})", "click": {"within": "CharacterPanel", "node": "Unequip"}, "expect": ["q.order('unequip')"]},
    {"id": "equipo_probado", "say": "Al menos una de las dos se pudo", "expect": ["q.flow_has('equip') or q.flow_has('unequip')"], "soft": true},
    {"id": "esc_ficha", "key": "Escape"},
    {"id": "x4", "key": "@speed_3"},
    {"id": "algun_aviso", "say": "Pasa el tiempo hasta que hay avisos", "until": "q.st().notices.size() > 0", "timeout": 30, "fast": 6},
    {"id": "libro", "key": "@ledger"},
    {"id": "avisos", "say": "La pestaña de avisos los marca leídos", "click": {"via": "LedgerPanel", "fn": "tab_button", "args": ["notices"]}, "expect": ["q.order('read_notices')"], "soft": true},
    {"id": "esc_libro", "key": "Escape"},
    {"id": "al_tablon", "world": {"service": "board"}, "button": "right", "until": "q.visible('BoardPanel')", "timeout": 40, "fast": 4},
    {"id": "aceptar", "click": {"within": "BoardPanel", "node": "Accept", "enabled": true}, "until": "q.contracts_mine() > 0", "timeout": 6},
    {"id": "abandonar", "say": "Abandonar: pide confirmación", "click": {"within": "MineList", "node": "Abandon"}, "expect": ["q.visible('ConfirmModal')"]},
    {"id": "abandonar_si", "click": {"within": "ConfirmModal", "node": "ConfirmButton"}, "expect": ["q.order('abandon_contract')"]},
    {"id": "esc_tablon", "key": "Escape"},
    {"id": "ascenso", "say": "Aparte: la aprendiz que pide ascenso", "restart": {"scenario": "apprentice_promotion"}},
    {"id": "x4_b", "key": "@speed_3"},
    {"id": "aviso_ascenso", "until": "q.shown({'within': 'StaffPanel', 'node': 'Accept'}) or q.st().notices.size() > 0", "timeout": 40, "fast": 6},
    {"id": "gestion_b", "world": {"own": "forge"}, "double": true, "until": "q.interior() == q.own('forge')", "timeout": 6},
    {"id": "empleados_b", "key": "@panel_staff", "expect": ["q.visible('StaffPanel')"]},
    {"id": "plantilla_b", "click": {"node": "StaffTab"}},
    {"id": "aceptar_ascenso", "click": {"within": "List", "node": "Accept"}, "expect": ["q.order('promote')"]}
  ]
}
