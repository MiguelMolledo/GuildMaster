{
  "id": "taberna",
  "title": "Comprar la taberna y llevar un turno",
  "about": "En una partida nueva la Taberna-Posada está en venta: su barra de selección dice el precio y, sin oro bastante, por qué no se puede. Con la taberna ya comprada (escenario innkeeper_start, el protagonista dentro una hora antes de abrir): el panel de la taberna (botón de la barra), la carta (quitar y poner un plato, su precio, el plato del día), las habitaciones (hacer una cama), la licencia, y la noche a ×4 hasta el resumen del turno.",
  "start": {"new_game": true},
  "covers": ["buy_building", "inn_set_menu", "inn_set_price", "inn_set_special", "inn_make_bed", "inn_buy_license", "inn_serve"],
  "steps": [
    {"id": "sin_tutorial", "click": {"node": "TutorialCheck"}},
    {"id": "empezar", "click": {"node": "StartButton"}, "until": "not q.visible('NewGameScreen') and q.fam() != ''", "timeout": 6},
    {"id": "taberna_mapa", "say": "Clic en la Taberna-Posada del mapa", "world": {"building": "tavern_inn"}, "expect": ["q.visible('BuyButton')"]},
    {"id": "comprar", "say": "Comprarla; sin oro bastante, el botón dice por qué", "when": "not q.disabled({'node': 'BuyButton'})", "click": {"node": "BuyButton"}, "expect": ["q.order('buy_building')"]},
    {"id": "comprar_no", "when": "q.disabled({'node': 'BuyButton'})", "expect": ["q.tip({'node': 'BuyButton'}) != ''"]},
    {"id": "rica_escena", "say": "La misma partida con 3000 de oro (escenario tavern_for_sale)", "restart": {"scenario": "tavern_for_sale"}},
    {"id": "taberna_mapa_2", "world": {"building": "tavern_inn"}, "expect": ["q.visible('BuyButton')"]},
    {"id": "comprar_rica", "say": "Comprarla", "click": {"node": "BuyButton", "enabled": true}, "until": "q.owns('tavern_inn')", "timeout": 8, "expect": ["q.order('buy_building')"]},
    {"id": "comprada", "say": "La taberna ya comprada (escenario innkeeper_start)", "restart": {"scenario": "innkeeper_start"}},
    {"id": "gestion", "say": "Doble clic en la taberna propia: se gestiona", "world": {"own": "tavern_inn"}, "double": true, "until": "q.interior() == q.own('tavern_inn')", "timeout": 6},
    {"id": "panel", "say": "El botón Taberna de la barra del edificio", "click": {"node": "InnButton"}, "expect": ["q.visible('InnPanel')"]},
    {"id": "carta", "click": {"node": "TabMenu"}},
    {"id": "quitar_plato", "say": "Quitar el pan de la carta", "click": {"within": {"node": "Dish_bread"}, "type": "CheckBox"}, "expect": ["q.order('inn_set_menu')"]},
    {"id": "poner_plato", "say": "Y volver a ponerlo", "click": {"within": {"node": "Dish_bread"}, "type": "CheckBox"}, "expect": ["q.order('inn_set_menu')"]},
    {"id": "precio", "say": "Subir su precio (+)", "click": {"within": {"node": "Dish_bread"}, "text": "+", "exact": true}, "expect": ["q.order('inn_set_price')"]},
    {"id": "espera_plato", "say": "El plato vuelve a la carta: su ★ se enciende", "until": "q.shown({'within': {'node': 'Dish_bread'}, 'text': '★', 'exact': true, 'enabled': true})", "timeout": 6},
    {"id": "plato_dia", "say": "El plato del día (★)", "click": {"within": {"node": "Dish_bread"}, "text": "★", "exact": true, "enabled": true}, "expect": ["q.order('inn_set_special')"]},
    {"id": "habitaciones", "click": {"node": "TabRooms"}},
    {"id": "cama", "say": "Hacer una cama", "when": "q.shown({'within': 'InnPanel', 'tr': 'ui.inn.make_bed', 'enabled': true})", "click": {"within": "InnPanel", "tr": "ui.inn.make_bed", "enabled": true}, "expect": ["q.order('inn_make_bed')"]},
    {"id": "licencia", "say": "La licencia (si se ofrece)", "when": "q.shown({'node': 'LicenseButton', 'enabled': true})", "click": {"node": "LicenseButton"}, "expect": ["q.order('inn_buy_license')"]},
    {"id": "turno", "click": {"node": "TabTurn"}},
    {"id": "x4", "key": "@speed_3"},
    {"id": "noche", "say": "La noche: entra la clientela", "until": "q.hour() >= 21", "timeout": 60, "fast": 6},
    {"id": "esc", "key": "Escape", "expect": ["not q.visible('InnPanel')"]},
    {"id": "sala_escena", "say": "La sala llena con camas sin hacer (escenario inn_chores)", "restart": {"scenario": "inn_chores"}},
    {"id": "sala_dentro", "say": "Doble clic en la taberna propia (Hugo ya está dentro)", "when": "q.interior() == ''", "world": {"own": "tavern_inn"}, "double": true, "until": "q.interior() == q.own('tavern_inn')", "timeout": 6},
    {"id": "servir", "say": "Clic en un parroquiano que espera: servirle", "inn": "guest", "expect": ["q.order('inn_serve')"]},
    {"id": "hacer_cama", "say": "Clic en una cama sin hacer", "inn": "bed", "expect": ["q.order('inn_make_bed')"]}
  ]
}
